static func canonical(key: String) -> String:
	return ALIASES.get(key, key)

## Damage-type name used in "increased_<type>_damage" keys.
static func type_damage_key(damage_type: int) -> String:
	return "increased_%s_damage" % String(Constants.DAMAGE_TYPE_NAME.get(damage_type, "")).to_lower()

