# Godot 4+
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
.mono/
data_*/
mono_crash.*.json
builds/

# MDX->glTF pipeline (tools/mdx_pipeline/) - node_modules is
# regenerable via `npm install`, .glb outputs are build artifacts.
tools/mdx_pipeline/node_modules/
tools/mdx_pipeline/*.glb

# Raw sound library (1 GB+, licensed source files). tools/sfx_pipeline/
# cuts it into assets/sfx/; assets/sound/.gdignore keeps Godot out of it.
assets/sound/
