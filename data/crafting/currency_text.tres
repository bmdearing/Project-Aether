descriptions = {
"absolution": "Removes all modifiers that aren't anchored. The item returns to Common, or to Uncommon if an anchored modifier remains.",
"anchoring": "Permanently locks one random modifier on an item with at least 3 modifiers.",
"ascendant": "Adds one modifier to a Rare item.",
"brand_prefix": "The next Orb adds or removes only a prefix.",
"brand_preservation": "Every other Brand used on the next Orb is kept.",
"brand_suffix": "The next Orb adds or removes only a suffix.",
"crystallized_aether": "Raises a spell's level at the Abilities screen, along with gold.",
"edict_attack": "Attack modifiers can't roll on this item's next craft.",
"edict_prefix": "Prefixes can't be removed or changed by this item's next craft.",
"edict_spell": "Spell modifiers can't roll on this item's next craft.",
"edict_suffix": "Suffixes can't be removed or changed by this item's next craft.",
"elevation": "Upgrades an Uncommon item to Rare and adds one modifier.",
"forging": "Upgrades a Common item to Rare and adds four modifiers (three or four on a Slate).",
"grafting": "Adds one modifier to an Uncommon item.",
"opening": "Rolls sockets on an item with none. Works once per item.",
"quickening": "Upgrades a Common item to Uncommon and adds one modifier.",
"recasting": "Removes one random modifier from a Rare item, then adds one.",
"reckoning": "Rerolls every modifier's value within its current tier.",
"severance": "Removes one random modifier.",
"tempering": "Adds 2 to 4 quality to armour or a weapon, up to 20."
}
errors = {
"ALREADY_ANCHORED": "This item already has an anchored modifier.",
"CORRUPTED": "Corrupted items can only take an Orb of Opening or an Orb of Tempering.",
"INVALID_TARGET": "That can't be used on this item.",
"MISSING_CURRENCY": "You don't have that currency.",
"NOTHING_TO_REMOVE": "There's no modifier that can be removed.",
"NO_OPEN_AFFIX": "There's no open prefix or suffix.",
"NO_TOLERANCE": "This item has no Aether Tolerance left.",
"NO_VALID_OUTCOME": "No modifier fits every active Brand and Edict.",
"QUALITY_CAPPED": "This item is already at maximum quality.",
"SOCKETS_ALREADY_ROLLED": "This item's sockets have already been rolled.",
"TOO_FEW_MODIFIERS": "This item doesn't have enough modifiers."
