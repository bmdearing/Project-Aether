descriptions = {
"maw_fragment_ash": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_hollow": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_storm": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_tide": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"absolution": "Removes all modifiers that aren't anchored (with Brands active, only the matching ones). The item returns to Common, or to Uncommon if an anchored modifier remains.",
"anchoring": "Permanently locks one random modifier on an item with at least 3 modifiers. Active Brands narrow which ones it can pick.",
"ascendant": "Adds one modifier to a Rare item.",
"brand_aetheric": "While active, the next Orb only works with Aetheric modifiers: it only adds Aetheric modifiers, and Severance, Absolution, Recasting and Anchoring only pick Aetheric modifiers. Stack Brands to narrow further. Consumed when used.",
"brand_armor": "While active, the next Orb only works with Armor modifiers: it only adds Armor modifiers, and Severance, Absolution, Recasting and Anchoring only pick Armor modifiers. Stack Brands to narrow further. Consumed when used.",
