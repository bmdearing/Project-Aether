descriptions = {
"maw_fragment_ash": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_hollow": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_storm": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"maw_fragment_tide": "One of four. Dropped by Figment bosses. Bring all four to the Reality Engine to open the Pinnacle.",
"crystallized_aether": "Raises a spell's level at the Abilities screen, along with gold.",
"tempering": "Adds 2 to 4 quality to a weapon or armour piece, up to 25. On weapons each point is 1% more weapon damage; on armour and shields, 1% more base defences. Works on corrupted, Unique and Mythic items.",
"shard_of_tharsis": "Corrupts an item: a random outcome, good or bad. Corrupted items can't be crafted at the Siphon further, except for Sockets.",
"residue_physical": "Left by enemies dealing Physical damage (Kinetic, Piercing, Explosive). Pays for Kinetic, Piercing, Explosive and Armour crafts, and any generic craft.",
"residue_elemental": "Left by enemies dealing Elemental damage (Fire, Cold, Lightning). Pays for Fire, Cold, Lightning and Evasion crafts, and any generic craft.",
"residue_esoteric": "Left by enemies dealing Esoteric damage (Aetheric, Entropic, Pale). Pays for Aetheric, Entropic, Pale and Ward crafts, and any generic craft.",
"residue_boss": "Left by bosses. Pays for Vestige crafts: modifiers from the bosses you've killed.",
"craft_add": "Adds one modifier (from the family, if one is picked). Raises the rarity only when it has to.",
"craft_recast": "Replaces one random non-anchored modifier with a new one.",
"craft_bleed": "Removes one random non-anchored modifier. Rarity stays.",
"craft_absolve": "Removes every non-anchored modifier. Rarity drops to fit what's left.",
"craft_settle": "Rerolls the values of the modifiers within their tiers. Unfocused, it also rerolls a Lens's radius.",
"craft_anchor": "Anchors the modifier you choose: no craft removes, replaces or rerolls it.",
"craft_sockets": "Rerolls the sockets (1 up to the item's maximum). Take jewels out first.",
"craft_retype": "Changes a weapon's damage type to the one you choose.",
"craft_restore_type": "Returns a weapon to its native damage type.",
"craft_vestige_add": "Adds one modifier from a boss you've killed."
}
errors = {
"ALREADY_ANCHORED": "This item already has its most anchored modifiers.",
