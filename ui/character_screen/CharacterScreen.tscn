[node name="HintLabel" type="Label" parent="CenterContainer/VBox"]
autowrap_mode = 3
text = "All six stats come from gear only (no allocation on level-up). Strength/Arcane/Enigma scale Physical/Elemental/Esoteric damage; Vitality raises Life + regen; Instinct raises Crit Chance + Attack/Cast/Move speed; Intellect raises Crit Damage + Mana + regen. Not yet wired: Vitality's DoT mitigation, Instinct's Stamina/dodge-roll, Intellect's Debuff effectiveness - no supporting systems exist for those yet. Predicted damage numbers already factor in crit and match exactly what attacking/casting deals."

